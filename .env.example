# Copy to .env.local for local overrides. Real values are set in the host's
# build environment (Cloudflare Pages → Settings → Environment variables).

# Canonical public origin. Drives robots.txt / sitemap.xml (scripts/generate-seo-files.mjs)
# and the og:url / og:image share tags (vite.config.ts). No trailing slash.
# Build-time only, NOT prefixed with VITE_ — it never reaches the browser bundle.
SITE_URL=https://www.example.com

# GA4 measurement ID. Leave EMPTY everywhere except production: when it is unset,
# no GA script is loaded and no events are sent (see src/analytics/ga.ts).
VITE_GA_ID=

# Canonical public origin for the BROWSER bundle. Used for auth e-mail links
# (sign-up confirmation, password reset) so a sign-up started on a local dev
# server still points people at the real site, not http://localhost. No trailing
# slash. In production the running origin already is the real site, so this is
# only strictly needed for local testing. Must also be on Supabase's redirect
# allow-list (Auth → URL Configuration). Set this to the deployed URL, e.g.
# VITE_SITE_URL=https://thai-dd.pages.dev
VITE_SITE_URL=

# Supabase (browser). The anon key is public by design — RLS decides everything.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CLI ONLY — never prefix with VITE_, never commit, never put in the browser:
# the service_role key bypasses RLS. Used by scripts/upload-catalog-images.mjs
# and scripts/import-project.mjs to write into the "catalog" Storage bucket.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
