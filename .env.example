# Copy to .env.local for local overrides. Real values are set in the host's
# build environment (Cloudflare Pages → Settings → Environment variables).

# Canonical public origin. Drives robots.txt / sitemap.xml (scripts/generate-seo-files.mjs)
# and the og:url / og:image share tags (vite.config.ts). No trailing slash.
# Build-time only, NOT prefixed with VITE_ — it never reaches the browser bundle.
SITE_URL=https://www.example.com

# GA4 measurement ID. Leave EMPTY everywhere except production: when it is unset,
# no GA script is loaded and no events are sent (see src/analytics/ga.ts).
VITE_GA_ID=
