{
  "name": "cgwebsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "vite",
    "seo": "node scripts/generate-seo-files.mjs",
    "og": "python3 scripts/make-og-card.py",
    "images:upload": "node scripts/upload-catalog-images.mjs",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "tsc -b && vite build && pnpm run build:ssr && pnpm run prerender",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:status": "supabase migration list",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist",
    "images:thumbs": "node scripts/backfill-thumbnails.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.115.0",
    "@types/three": "^0.185.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "supabase": "^2.116.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
